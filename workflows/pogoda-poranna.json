      "parameters": {
        "jsCode": "// Szukamy najwyższej i najniższej temperatury dnia oraz ich godzin\nconst dane = $input.first().json;\nconst godziny = dane.hourly.time;\nconst temperatury = dane.hourly.temperature_2m;\n\nlet najwyzsza = temperatury[0];\nlet najnizsza = temperatury[0];\nlet godzinaNajwyzszej = godziny[0];\nlet godzinaNajnizszej = godziny[0];\n\nfor (let i = 0; i < temperatury.length; i++) {\n  if (temperatury[i] > najwyzsza) {\n    najwyzsza = temperatury[i];\n    godzinaNajwyzszej = godziny[i];\n  }\n\n  if (temperatury[i] < najnizsza) {\n    najnizsza = temperatury[i];\n    godzinaNajnizszej = godziny[i];\n  }\n}\n\nreturn [{ json: { najwyzsza, godzinaNajwyzszej, najnizsza, godzinaNajnizszej } }];"
      },
